          "min-instances": 0,
          "max-instances": 20,
          "cpu-boost": false,
          "cpu-throttle": true
        },
        "container": {
          "environment": "gen2",
          "vcpus": 1,
          "gcp-concurrency": 80,
          "worker-concurrency": 1,
          "worker-threads": 8,
          "min-instances": 0,
          "max-instances": 20,
          "cpu-boost": false,
          "cpu-throttle": true
        }
      }
