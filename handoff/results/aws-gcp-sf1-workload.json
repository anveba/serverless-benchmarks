{
  "date": "2026-11-09",
  "scale_factor": 1,
  "driver": "laptop over the internet, not in either region",
  "workload": {
    "requests": 10,
    "interval_s": 2,
    "order": [
      "q6",
      "q1",
      "q12",
      "q3",
      "q21"
    ],
    "max_in_flight": 2
  },
  "aws": {
    "service": "Lambda",
    "region": "eu-north-1",
    "memory_mb": 2048,
    "cpu": "proportional to memory",
    "runtime": "python3.12 x86_64",
    "trigger": "SDK"
  },
  "gcp": {
    "service": "Cloud Functions gen2 (Cloud Run)",
    "region": "europe-west1",
    "memory_mb": 2048,
    "vcpus": 1,
    "concurrency_per_instance": 1,
    "runtime": "python3.12 x86_64",
    "trigger": "HTTP"
  },
  "engine": "DuckDB 2.0.0, httpfs, new connection per query, external file cache off",
  "price_assumptions": {
    "aws_gb_s": 1.66667e-05,
    "aws_per_request": 2e-07,
    "s3_get": 4.0000000000000003e-07,
    "gcp_vcpu_s": 2.4e-05,
    "gcp_gib_s": 2.5e-06,
    "gcp_per_request": 4e-07,
    "gcs_class_b": 4.0000000000000003e-07,
    "note": "List prices from memory, not checked for these regions; free tiers ignored. GCP billed time is estimated as the handler time rounded up to 100 ms, since SeBS does not receive GCP billing data. AWS billed GB-seconds are from the Lambda report."
  },
